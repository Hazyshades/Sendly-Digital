# Checked-in, non-secret defaults for the deterministic browser suite.
# playwright.config.ts supplies the same values to the Vite web server so a
# shell does not need platform-specific environment-variable syntax.
VITE_DEV_HTTPS=false
VITE_E2E=true
VITE_ARC_RPC_URL=http://127.0.0.1:4173/__e2e__/rpc
VITE_TEMPO_RPC_URL=http://127.0.0.1:4173/__e2e__/rpc
VITE_BASE_RPC_URL=http://127.0.0.1:4173/__e2e__/rpc
VITE_BASE_RPC_FALLBACK_URL=http://127.0.0.1:4173/__e2e__/rpc
VITE_SUPABASE_FUNCTION_URL=http://127.0.0.1:4173/__e2e__/functions/v1/smart-action
VITE_SUPABASE_ZKSEND_FUNCTION_URL=http://127.0.0.1:4173/__e2e__/functions/v1/smart-action
VITE_ZKTLS_SERVICE_URL=http://127.0.0.1:4173/__e2e__
VITE_APP_ORIGIN=http://zk.localhost:4173
VITE_PRIVY_APP_ID=e2e-privy-app-id
VITE_WALLET_CONNECT_PROJECT_ID=e2e-walletconnect-project-id
